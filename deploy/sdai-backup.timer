# Расписание резервных копий (E10-05): раз в сутки.
#
# Ночное время выбрано не ради нагрузки — её нет, — а чтобы копия и суточная
# граница совпадали: копия «за вчера» существует в единственном экземпляре.
# Persistent=true догоняет пропущенный запуск после перезагрузки машины: иначе
# сутки простоя означали бы сутки без копии.
#
# Срок хранения задаёт не таймер, а SDAI_BACKUP_KEEP_DAYS (по умолчанию 14):
# копию старше срока удаляет `backup prune` в том же запуске.

[Unit]
Description=Ежесуточная резервная копия базы сервиса самопознания

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=300
Persistent=true
Unit=sdai-backup.service

[Install]
WantedBy=timers.target
