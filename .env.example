# Переменные окружения сервера. Значений здесь нет и не должно быть:
# файл показывает состав, а не настройки. Скопировать в .env и заполнить.
#
# .env в репозиторий не попадает (.gitignore). Секретов сервер пока не требует:
# LLM-провайдер (E4-01) и платёжный провайдер (E8-01) добавят свои переменные.

# Адрес и порт, на которых слушает сервер. По умолчанию 127.0.0.1:8787.
SDAI_HOST=
SDAI_PORT=

# Файл базы SQLite. По умолчанию server/.data/app.db.
SDAI_DB_PATH=

# Применять непринятые миграции при старте: 1 или 0. По умолчанию 1.
SDAI_DB_AUTO_MIGRATE=

# Внешний адрес сервиса для постоянных ссылок, например https://example.com.
# Пусто — ссылки отдаются относительными (домен ещё не выбран).
SDAI_PUBLIC_ORIGIN=

# Предел размера тела запроса в байтах. По умолчанию 65536.
SDAI_MAX_BODY_BYTES=
