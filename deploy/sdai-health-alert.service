# Оповещение о падении проверки доступности (E10-09).
#
# Запускается через OnFailure у sdai-health.service. Внешнего канала
# (почта, мессенджер) нет, пока нет аккаунта основателя: сигнал — запись
# в журнал systemd, которую забирает любой сторож журнала на машине.
# Когда появится канал — этот файл получит вторую ExecStart, сам таймер
# не меняется.

[Unit]
Description=Оповещение: сервис самопознания не отвечает

[Service]
Type=oneshot
ExecStart=/usr/bin/logger -t sdai-health "сервис не отвечает: проверка /api/health не прошла"
