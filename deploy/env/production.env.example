# Рабочее окружение. Скопировать в /etc/sdai/production.env, права 0600.
# Значений секретов здесь нет. Домен — из content/identity.md; при смене хоста
# меняется эта строка вместе с DOMAIN и ORIGIN в идентичности (deploy/domain.md).

SDAI_ENV=production
SDAI_HOST=127.0.0.1
SDAI_PORT=8787
SDAI_PUBLIC_ORIGIN=https://wordpop.ru
SDAI_DB_PATH=/var/lib/sdai/app.db
SDAI_DB_AUTO_MIGRATE=1
SDAI_TRUST_PROXY=1
SDAI_ENCRYPTION_KEY=
SDAI_PAYMENT_PROVIDER=fake
SDAI_PAYMENT_WEBHOOK_SECRET=
SDAI_BACKUP_DIR=/var/backups/sdai
SDAI_BACKUP_KEEP_DAYS=14
SDAI_ERROR_TRACKER=fake
SDAI_ADMIN_SECRET=
SDAI_BUILD_VERSION=
SDAI_BUILD_COMMIT=
SDAI_BUILD_AT=
