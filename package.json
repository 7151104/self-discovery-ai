{
  "name": "self-discovery-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Движок и прототип AI-сервиса самопознания на 16 координатах",
  "scripts": {
    "build:content": "node engine/scripts/build-content.mjs",
    "build": "npm run build:content && tsc -p tsconfig.json",
    "test": "npm run build && node --test engine/dist/*.test.js",
    "serve": "npm run build && node tools/serve.mjs",
    "clean": "rm -rf engine/dist engine/src/generated"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.7.2"
  }
}
