# Переменные окружения сервера. Значений здесь нет и не должно быть:
# файл показывает состав, а не настройки. Скопировать в .env и заполнить.
#
# .env в репозиторий не попадает (.gitignore). Единственный секрет — ключ
# LLM-провайдера; платёжный провайдер (E8-01) добавит свои переменные.

# Окружение: development, staging или production. По умолчанию development.
# В staging и production переменные, помеченные ниже «обязательна», должны быть
# заданы, иначе сервер не стартует и называет недостающую.
# Разница между staging и production одна: в staging разрешён поддельный
# платёжный провайдер, в production — нет.
SDAI_ENV=

# Адрес и порт, на которых слушает сервер. По умолчанию 127.0.0.1:8787.
SDAI_HOST=
SDAI_PORT=

# Файл базы SQLite. По умолчанию server/.data/app.db.
# Обязательна в staging и production: путь по умолчанию лежит внутри каталога
# выпуска, а он заменяется при деплое; двум окружениям на одной машине нужны
# два разных файла, иначе предварительное окружение видит рабочие данные.
SDAI_DB_PATH=

# Применять непринятые миграции при старте: 1 или 0. По умолчанию 1.
SDAI_DB_AUTO_MIGRATE=

# Внешний адрес сервиса, например https://example.com. Из него собираются
# постоянная ссылка на страницу и публичная ссылка. Обязательна в production:
# без неё ссылки относительные, то есть непригодные для отправки другому.
SDAI_PUBLIC_ORIGIN=

# Предел размера тела запроса в байтах. По умолчанию 65536.
SDAI_MAX_BODY_BYTES=

# Брать адрес клиента из заголовка x-forwarded-for: 1 или 0. По умолчанию 0.
# Включать только за собственным обратным прокси: иначе лимиты обходятся
# подделкой заголовка.
SDAI_TRUST_PROXY=

# Ограничение частоты целиком: 1 или 0. По умолчанию 1.
SDAI_RATE_LIMIT=

# Пределы по корзинам. Числа — сколько запросов с одного адреса разрешено в окне.
# Создание профилей — за час, остальное — за минуту.
# По умолчанию 20 / 60 / 120 / 20.
SDAI_RATE_CREATE_PROFILE=
SDAI_RATE_PORTION=
SDAI_RATE_STATE=
# Промахи: запросы к несуществующим профилям и публичным ссылкам, то есть перебор.
SDAI_RATE_MISS=

# Ключ шифрования чувствительных полей: 32 байта в base64.
# Новый печатает `npm run keygen`; в файлы и в базу он не записывается.
# Обязателен в production. Без него имя, дата рождения, ответы, снимки профиля
# и тексты блоков лягут в базу открытым текстом.
SDAI_ENCRYPTION_KEY=

# Ключи, выведенные из обращения: через запятую, в том же виде.
# Ими ещё читаются старые записи, новые ими не пишутся. После `npm run reencrypt`
# переменную можно очистить.
SDAI_ENCRYPTION_KEYS_RETIRED=

# Имя платёжного провайдера в реестре `server/src/payments/`.
# По умолчанию `fake` — поддельный провайдер для тестов и сквозных прогонов.
# В production `fake` запрещён: с таким сочетанием сервер не стартует.
SDAI_PAYMENT_PROVIDER=

# Секрет для проверки подписи уведомлений провайдера. Обязателен в production.
SDAI_PAYMENT_WEBHOOK_SECRET=

# Каталог резервных копий базы. По умолчанию server/.backups.
# Обязательна в staging и production и должна лежать вне каталога выпуска:
# копия внутри выпуска исчезает вместе с ним при деплое или откате.
SDAI_BACKUP_DIR=

# Срок хранения копий в сутках. По умолчанию 14.
# Более старые удаляет `npm run backup -- prune`; три последние копии остаются
# всегда, даже если они старше срока.
SDAI_BACKUP_KEEP_DAYS=

# Имя приёмника ошибок в реестре `server/src/observability/`.
# По умолчанию `fake` — пишет в память и, если задан путь, в файл.
# В отличие от платежей, поддельный приёмник в production разрешён:
# внешнего сервиса ещё нет, а ошибки собирать уже нужно.
SDAI_ERROR_TRACKER=

# Файл JSONL для поддельного приёмника. По умолчанию пусто — только память.
SDAI_ERROR_TRACKER_PATH=

# Лимит клиентских ошибок с одного адреса за минуту. По умолчанию 30.
SDAI_RATE_ERROR=

# Версия сборки: тег выпуска. По умолчанию версия из package.json.
# Уходит в ответ GET /api/health — по нему видно, что развёрнуто и что откатили.
SDAI_BUILD_VERSION=

# Коммит, из которого собрано. По умолчанию unknown.
SDAI_BUILD_COMMIT=

# Время сборки в ISO-8601. По умолчанию не показывается.
SDAI_BUILD_AT=

# ── Слой генерации (server/llm/) ──────────────────────────────────────────────
#
# Переменные слоя LLM (SDAI_LLM_*) с описаниями и значениями по умолчанию —
# в server/llm/README.md, раздел «Переменные окружения». Ключ провайдера
# (SDAI_LLM_API_KEY) — единственный секрет сервиса.
#
# Здесь их пока нет по одной причине: тест `server/src/secrets.test.ts` сверяет
# этот файл только с `server/src/config.ts`, а настройки слоя живут в
# `server/llm/src/config.ts`. Переезд списка сюда — одна строка в том тесте
# (объединить два модуля настроек), и её делает владелец сервера: каталог
# `server/src/` сейчас занят другой задачей. Полноту списка до тех пор держит
# тест `server/llm/src/config.test.ts`.
