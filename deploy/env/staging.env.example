# Предварительное окружение. Скопировать в /etc/sdai/staging.env, права 0600.
# Свой файл базы и свой ключ: данные рабочего окружения отсюда не видны.

SDAI_ENV=staging
SDAI_HOST=127.0.0.1
SDAI_PORT=8788
SDAI_PUBLIC_ORIGIN=https://staging.wordpop.ru
SDAI_DB_PATH=/var/lib/sdai/staging.db
SDAI_DB_AUTO_MIGRATE=1
SDAI_TRUST_PROXY=1
SDAI_ENCRYPTION_KEY=
SDAI_PAYMENT_PROVIDER=fake
SDAI_PAYMENT_WEBHOOK_SECRET=
SDAI_BACKUP_DIR=/var/backups/sdai-staging
SDAI_BACKUP_KEEP_DAYS=14
SDAI_ERROR_TRACKER=fake
SDAI_ADMIN_SECRET=
